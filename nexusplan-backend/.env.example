

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

AUTH_SECRET_KEY=change-me-auth-secret-key
PROJECT_SECRET_KEY=change-me-project-secret-key
TASK_SECRET_KEY=change-me-task-secret-key
AI_SECRET_KEY=change-me-ai-secret-key
REALTIME_SECRET_KEY=change-me-realtime-secret-key

POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=nexusplan_db
DATABASE_URL=postgres://nexus_user:change-me-db-password@db:5432/nexusplan_db

REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── LLM provider keys (ai_service) ────────────────────────────────────────
# Fallback order: Gemini → Grok → OpenRouter
GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: override the default model for each provider
# GEMINI_MODEL=gemini-2.0-flash
# GROK_MODEL=grok-3-mini
# OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
